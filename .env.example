APP_ENV=production
APP_URL=https://your-app.vercel.app
# 64 hex chars, e.g. php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Set to "vercel" when deployed on Vercel so client IPs are read from the proxy header.
TRUST_PROXY=
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=retro_app.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
ASSET_VERSION=1
